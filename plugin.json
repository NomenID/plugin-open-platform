{
    "name": "Open Platform",
    "version": "1.0.0",
    "description": "Developer portal: register developers, self-manage OAuth apps",
    "license": "GPL-3.0-only",
    "author": [
        "Yunyun (Wang Yaoze)"
    ],
    "requires": {
        "Nomen": ">=1.0"
    },
    "autoload": {
        "Nomen\\Plugin\\OpenPlatform\\": "src/"
    },
    "boot": [
        "Nomen\\Plugin\\OpenPlatform\\Plugin",
        "boot"
    ],
    "mounts": {
        "portal": {
            "path": "/open",
            "title": "开放平台",
            "description": "Developer registration and self-managed apps",
            "access": "public",
            "config": "base_path"
        }
    },
    "adminPages": {
        "developers": {
            "title": "开发者",
            "description": "Developers registered on the open platform, and the apps under their names",
            "handler": [
                "Nomen\\Plugin\\OpenPlatform\\AdminPage",
                "render"
            ],
            "group": "用户与接入",
            "order": 35
        }
    },
    "homepage": "https://nomen.caellab.com/w/plugin-open-platform"
}
